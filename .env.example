# Radar Municipal — Variables de entorno
# Copiar a .env y completar los valores

# URL base de la API (usado por el frontend para links de descarga)
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL pública del sitio (usado para sitemap, OG tags, canonical)
NEXT_PUBLIC_SITE_URL=https://radarmunicipal.ar

# Puerto de la API Hono
API_PORT=3001

# Base de datos PostgreSQL
DATABASE_URL=postgresql://radar:radar_dev_password@localhost:5432/radar_municipal
