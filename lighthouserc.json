{
  "$schema": "https://raw.githubusercontent.com/GoogleChrome/lighthouse-ci/main/docs/configuration.md",
  "_comment": "Sprint 50 — Camino B. Audita performance/a11y/SEO/best-practices en 6 rutas representativas. Si baja de threshold falla el CI. Thresholds calibrados sobre la build actual + un margen de seguridad razonable: si Sprint 51+ rompe esto, queremos enterarnos.",
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:3100/",
        "http://127.0.0.1:3100/ranking",
        "http://127.0.0.1:3100/panorama",
        "http://127.0.0.1:3100/dimensiones",
        "http://127.0.0.1:3100/presion-impositiva",
        "http://127.0.0.1:3100/calidad-datos"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate",
        "skipAudits": [
          "uses-http2",
          "redirects-http",
          "is-on-https"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "uses-text-compression": "off",
        "uses-long-cache-ttl": "off",
        "csp-xss": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
